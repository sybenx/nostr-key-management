{
  "spec": "TIERS.md",
  "version": "1.0-draft",
  "section": "2.2, 3.1, 3.2, 4.2, 4.3, 4.6",
  "description": "One membership per constraint, each chosen so that the named constraint fails. For (1), (2) and (3) every other required constraint and precondition holds, so the nonzero exit is attributable to the one named. (4) and (5) are optional: their cases exit 0 and report the failure, which is how a client learns a membership is not Profile A, or not policy-complete under Profile B. The preconditions are the MUSTs §4.2's inequalities assume; k >= 3 cannot fail alone, because k = 2 leaves no T with 1 < T < k.",
  "cases": [
    {
      "name": "(1) n_s < k: three co-signers at k = 3 sign alone",
      "violates": {
        "group": "required",
        "constraint": "1"
      },
      "membership": {
        "k": 3,
        "T": 2,
        "s": 1,
        "trusted_devices": [
          "D1"
        ],
        "co_signers": [
          "C1",
          "C2",
          "C3"
        ],
        "grants": []
      },
      "expect": {
        "exit": 1,
        "preconditions": {
          "k>=3": true,
          "N<=255": true,
          "T>1": true,
          "T<k": true,
          "D>=1": true,
          "w<T": true
        },
        "required": {
          "1": false,
          "2": true,
          "3": true
        },
        "optional": {
          "4": true,
          "5": true
        },
        "slack": {
          "trusted_device": 2,
          "grants": {}
        }
      }
    },
    {
      "name": "(2) W_g < k: three live grants at k = 3 sign alone",
