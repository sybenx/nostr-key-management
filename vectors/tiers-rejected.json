        "exit": 1,
        "preconditions": {
          "k>=3": true,
          "N<=255": true,
          "T>1": true,
          "T<k": true,
          "D>=1": true,
          "w<T": true
        },
        "required": {
          "1": true,
          "2": false,
          "3": true
